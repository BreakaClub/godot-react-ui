config_version=5

[application]
config/name="Godot React UI · Native playground"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=800

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.96, 0.97, 0.98, 1)

[GodotJS]
runtime/core/camel_case_bindings_enabled=true

[input_devices]
pointing/emulate_mouse_from_touch=true
