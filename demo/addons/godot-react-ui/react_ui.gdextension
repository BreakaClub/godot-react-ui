[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.dylib"
macos.release.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.dylib"
macos.debug.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.dylib"
macos.release.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.dylib"
linux.debug.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.linux.x86_64.so"
linux.release.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.linux.x86_64.so"
linux.debug.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.linux.arm64.so"
linux.release.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.linux.arm64.so"
windows.debug.x86_64 = "res://addons/godot-react-ui/bin/godot_react_ui.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/godot-react-ui/bin/godot_react_ui.windows.x86_64.dll"
windows.debug.arm64 = "res://addons/godot-react-ui/bin/godot_react_ui.windows.arm64.dll"
windows.release.arm64 = "res://addons/godot-react-ui/bin/godot_react_ui.windows.arm64.dll"
android.debug.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.android.arm64.so"
android.release.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.android.arm64.so"
android.debug.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.android.x86_64.so"
android.release.x86_64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.android.x86_64.so"
ios.debug.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.ios.arm64.dylib"
ios.release.arm64 = "res://addons/godot-react-ui/bin/libgodot_react_ui.ios.arm64.dylib"
web.debug.threads.wasm32 = "res://addons/godot-react-ui/bin/godot_react_ui.web.wasm"
web.release.threads.wasm32 = "res://addons/godot-react-ui/bin/godot_react_ui.web.wasm"
web.debug.nothreads.wasm32 = "res://addons/godot-react-ui/bin/godot_react_ui.web.nothreads.wasm"
web.release.nothreads.wasm32 = "res://addons/godot-react-ui/bin/godot_react_ui.web.nothreads.wasm"
