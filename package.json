{
  "name": "godot-react-ui",
  "version": "0.9.0",
  "description": "React for GodotJS, with native Rust/Taffy layout",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BreakaClub/godot-react-ui.git"
  },
  "bin": {
    "godot-react-ui": "./bin/cli.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "postinstall": "node ./bin/cli.mjs --postinstall",
    "setup": "node ./bin/cli.mjs setup",
    "stage:addon": "node ./scripts/stage-addon.mjs",
    "prepack": "node ./scripts/stage-addon.mjs",
    "test:types": "node scripts/test-types.mjs",
    "gen:types": "node scripts/generate-types.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:font-slices": "node scripts/build-font-slices.mjs",
    "build": "pnpm test:types && node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "predemo": "pnpm build",
    "demo": "node scripts/run.mjs",
    "demo:web": "node scripts/serve-web.mjs",
    "deploy:web:plan": "node scripts/deploy-web.mjs",
    "deploy:web": "node scripts/deploy-web.mjs --execute",
    "deploy:web:releases": "node scripts/deploy-web.mjs --releases",
    "deploy:web:rollback": "node scripts/deploy-web.mjs --rollback --execute",
    "check:site": "node scripts/check-site.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:motion:web": "node scripts/verify-motion-web.mjs",
    "verify:motion": "node scripts/verify.mjs --motion",
    "verify:interaction": "node scripts/verify.mjs --interaction",
    "verify:interaction:web": "node scripts/verify-interaction-web.mjs",
    "glass:reference": "node --import tsx scripts/glass-reference.mjs",
    "paint:reference": "node --import tsx scripts/paint-reference.mjs",
    "verify:world": "node scripts/verify-world.mjs",
    "verify:text-layout": "node scripts/verify-text-layout.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "19.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/virtual-core": "^3.19.11",
    "@types/node": "24.3.3",
    "@types/react": "19.2.0",
    "@types/react-reconciler": "0.33.0",
    "esbuild": "0.25.11",
    "puppeteer-core": "24.37.2",
    "react": "19.2.0",
    "react-refresh": "0.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/git-tag": "^11.3.6",
    "@auto-it/upload-assets": "^11.3.6",
    "auto": "^11.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "addon",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "auto": {
    "baseBranch": "main",
    "noVersionPrefix": true,
    "plugins": [
      [
        "conventional-commits",
        {
          "preset": "angular"
        }
      ],
      "git-tag",
      [
        "upload-assets",
        {
          "assets": [
            "release/godot-react-ui/*.tgz",
            "release/godot-react-ui/*.zip"
          ]
        }
      ]
    ]
  }
}
