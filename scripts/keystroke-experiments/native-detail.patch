diff --git a/native/detail.rs b/native/detail.rs
new file mode 100644
index 0000000..f420063
--- /dev/null
+++ b/native/detail.rs
@@ -0,0 +1,62 @@
+//! Diagnostic phase timers (docs/tracks/keystroke-profile.md). Not part of the library: a build with this file is a measuring build.
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+thread_local! {
+    static ENABLED: Cell<bool> = const { Cell::new(false) };
+    static TOTALS: RefCell<BTreeMap<&'static str, (u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+}
+
+pub fn enable(enabled: bool) {
+    ENABLED.with(|flag| flag.set(enabled));
+}
+
+/// Whether to print every paragraph measurement: the process was started with KEYSTROKE_TRACE_MEASURE set, and profiling is on.
+pub fn tracing() -> bool {
+    thread_local! { static ASKED: bool = std::env::var_os("KEYSTROKE_TRACE_MEASURE").is_some(); }
+    ENABLED.with(Cell::get) && ASKED.with(|asked| *asked)
+}
+
+pub struct Timer {
+    name: &'static str,
+    started: Option<Instant>,
+}
+
+/// Times the scope it is held in, inclusive of what it calls; the totals are in nanoseconds and the number of times it ran.
+pub fn timer(name: &'static str) -> Timer {
+    Timer { name, started: ENABLED.with(Cell::get).then(Instant::now) }
+}
+
+impl Drop for Timer {
+    fn drop(&mut self) {
+        if let Some(started) = self.started {
+            let nanos = started.elapsed().as_nanos() as u64;
+            TOTALS.with(|totals| {
+                let mut totals = totals.borrow_mut();
+                let entry = totals.entry(self.name).or_insert((0, 0));
+                entry.0 += nanos;
+                entry.1 += 1;
+            });
+        }
+    }
+}
+
+/// Counts `amount` things under `name` (no time).
+pub fn count(name: &'static str, amount: u64) {
+    if ENABLED.with(Cell::get) {
+        TOTALS.with(|totals| {
+            let mut totals = totals.borrow_mut();
+            let entry = totals.entry(name).or_insert((0, 0));
+            entry.1 += amount;
+        });
+    }
+}
+
+pub fn take() -> String {
+    TOTALS.with(|totals| {
+        let taken = std::mem::take(&mut *totals.borrow_mut());
+        let body: Vec<String> = taken.iter().map(|(name, (nanos, times))| format!("\"{name}\":[{nanos},{times}]")).collect();
+        format!("{{{}}}", body.join(","))
+    })
+}
