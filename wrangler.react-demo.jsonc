{
	"name": "godot-react-ui-demo",
	"main": "deploy/cloudflare-worker.ts",
	"compatibility_date": "2025-05-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"REACT_DEMO_R2_PREFIX": "react-demo/v2"
	},
	"r2_buckets": [
		{
			"binding": "ASSET_UPLOADS_BUCKET",
			"bucket_name": "breaka-asset-uploads"
		}
	],
	"routes": [
		{
			"pattern": "react.breaka.club",
			"custom_domain": true
		}
	]
}
