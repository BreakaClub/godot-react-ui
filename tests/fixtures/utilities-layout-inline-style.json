{
  "layers": [
    {
      "style": {
        "alignSelf": "auto",
        "gridTemplateColumns": [
          {
            "minmax": [
              0,
              "1fr"
            ]
          }
        ],
        "marginBottom": "auto",
        "marginLeft": "auto",
        "marginRight": "auto",
        "marginTop": "auto",
        "transition": {
          "properties": "all",
