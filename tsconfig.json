{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node", "react"],
    "paths": {"godot-react-ui": ["./src/index.ts"]}
  },
  "include": ["src", "demo/src", "demo/typings", "tests", "live-compile/types"]
}
